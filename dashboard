#!/bin/bash
# Friendly entry point: ./dashboard <command>  (works with the private Node
# runtime the installer sets up — no PATH setup needed).
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -x "$DIR/.node/bin/node" ]; then
  export PATH="$DIR/.node/bin:$PATH"
fi
command -v node >/dev/null || { echo "Node not found — re-run install.sh"; exit 1; }
if [ "${1:-}" = "open" ]; then
  exec open "$DIR/data/dashboard.html"
fi
exec node "$DIR/src/cli.js" "$@"
