{
  "name": "myschoolapp-dashboard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "School Board — a Mac menu-bar app for your kids' assignments and grades across multiple Blackbaud myschoolapp schools",
  "author": "Will Minkoff",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "app": "electron .",
    "dist": "electron-builder --mac"
  },
  "dependencies": {
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.willminkoff.myschoolapp-dashboard",
    "productName": "School Board",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!config.json",
      "!config.example.json",
      "!data/**",
      "!dist/**",
      "!scripts/**"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
