{
  "name": "myschoolapp-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One dashboard for your kids' assignments and grades across multiple Blackbaud myschoolapp schools",
  "author": "Will Minkoff",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "app": "electron .",
    "dist": "electron-builder --mac",
    "init": "node src/cli.js init",
    "login": "node src/cli.js login",
    "probe": "node src/cli.js probe",
    "fetch": "node src/cli.js fetch",
    "render": "node src/cli.js render",
    "all": "node src/cli.js all",
    "demo": "node src/cli.js demo"
  },
  "dependencies": {
    "playwright": "^1.49.0",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.willminkoff.myschoolapp-dashboard",
    "productName": "School Board",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!config.json",
      "!config.example.json",
      "!data/**",
      "!dist/**",
      "!dashboard",
      "!install.sh",
      "!scripts/**",
      "!sample/**",
      "!node_modules/playwright/**",
      "!node_modules/@playwright/**"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
